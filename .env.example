# Docker Compose reads this file after you copy it to .env.
# PowerShell Maven runs require $env:NAME="value"; they do not auto-load .env.
DB_PASSWORD=local-demo-db-password
JWT_SECRET=local-demo-secret-replace-with-at-least-32-random-bytes
SEED_DEMO=true
DEMO_PASSWORD=Demo@12345
MAIL_ENABLED=false
MAIL_FROM=careerbridge@example.com
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_TLS=true

# Native development only: start-dev.ps1 -EmailTesting enables the loopback inbox.
# Leave false for live/shared environments. SMTP mode requires MAIL_ENABLED=true.
LOCAL_EMAIL_TESTING=false
